<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ULTRON AI — Next-Gen Intelligence</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <!-- Markdown & Syntax Highlighting -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

  <style>
    :root {
      --bg-deep: #07070a;
      --bg-card: rgba(18, 19, 28, 0.75);
      --bg-card-hover: rgba(26, 28, 42, 0.85);
      --border-glow: rgba(255, 30, 66, 0.35);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --ultron-crimson: #ff1e42;
      --ultron-glow: #ff2a55;
      --ultron-dark-red: #6e0013;
      --accent-cyan: #00f2fe;
      --text-main: #f0f2f8;
      --text-muted: #8e95aa;
      --text-dim: #5c6275;
      --panel-blur: blur(16px);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --font-display: 'Orbitron', -apple-system, sans-serif;
      --font-tech: 'Rajdhani', -apple-system, sans-serif;
      --font-body: 'Inter', -apple-system, sans-serif;
      --font-code: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-color: var(--bg-deep);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(255, 30, 66, 0.15) 0%, transparent 60%),
        radial-gradient(circle at 10% 90%, rgba(110, 0, 19, 0.12) 0%, transparent 40%),
        linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
      color: var(--text-main);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Top Navigation */
    header {
      height: 72px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(7, 7, 10, 0.85);
      backdrop-filter: var(--panel-blur);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .brand-container {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .core-reactor {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #fff 0%, #ff1e42 45%, #4a000d 95%);
      box-shadow: 0 0 16px rgba(255, 30, 66, 0.7), inset 0 0 8px #fff;
      position: relative;
      cursor: pointer;
      transition: transform 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .core-reactor::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 1.5px dashed rgba(255, 60, 90, 0.6);
      animation: rotateRing 12s linear infinite;
    }

    .core-reactor.pulsing {
      animation: reactorPulse 1.2s infinite alternate ease-in-out;
    }

    @keyframes rotateRing {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes reactorPulse {
      0% { box-shadow: 0 0 10px rgba(255, 30, 66, 0.6); transform: scale(0.98); }
      100% { box-shadow: 0 0 28px rgba(255, 30, 66, 1), 0 0 45px rgba(255, 30, 66, 0.4); transform: scale(1.05); }
    }

    .brand-text h1 {
      font-family: var(--font-display);
      font-size: 1.3rem;
      letter-spacing: 3px;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-text .version-tag {
      font-family: var(--font-tech);
      font-size: 0.7rem;
      color: var(--ultron-crimson);
      background: rgba(255, 30, 66, 0.12);
      border: 1px solid rgba(255, 30, 66, 0.3);
      padding: 2px 7px;
      border-radius: 4px;
      letter-spacing: 1px;
    }

    .brand-text p {
      font-family: var(--font-tech);
      font-size: 0.85rem;
      color: var(--text-muted);
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .mode-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-tech);
      font-size: 0.85rem;
      color: #22c55e;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.25);
      padding: 5px 12px;
      border-radius: 20px;
    }

    .mode-badge::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e;
      animation: blink 2s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    .btn-icon {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-tech);
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-icon:hover {
      background: rgba(255, 30, 66, 0.15);
      border-color: rgba(255, 30, 66, 0.4);
      color: #fff;
    }

    /* Main Layout */
    .app-container {
      flex: 1;
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      padding: 16px 20px 24px;
      height: calc(100vh - 72px);
    }

    /* Controls Bar */
    .controls-strip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 12px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 16px;
      backdrop-filter: var(--panel-blur);
    }

    .persona-selector {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .persona-label {
      font-family: var(--font-tech);
      font-size: 0.85rem;
      color: var(--text-muted);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .segmented-control {
      display: flex;
      background: rgba(0, 0, 0, 0.35);
      padding: 3px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .segment-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-family: var(--font-tech);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
      letter-spacing: 0.5px;
    }

    .segment-btn.active {
      background: var(--ultron-crimson);
      color: #fff;
      box-shadow: 0 0 12px rgba(255, 30, 66, 0.5);
    }

    .tools-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .toggle-voice-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-tech);
      font-size: 0.82rem;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      padding: 5px 10px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .toggle-voice-btn.active {
      background: rgba(255, 30, 66, 0.2);
      border-color: var(--ultron-crimson);
      color: #ff6b84;
    }

    /* Messages Area */
    .chat-container {
      flex: 1;
      overflow-y: auto;
      padding: 20px 10px 20px 0;
      display: flex;
      flex-direction: column;
      gap: 20px;
      scroll-behavior: smooth;
    }

    .chat-container::-webkit-scrollbar {
      width: 6px;
    }

    .chat-container::-webkit-scrollbar-thumb {
      background: rgba(255, 30, 66, 0.25);
      border-radius: 4px;
    }

    .chat-container::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 30, 66, 0.5);
    }

    /* Message Item */
    .message-row {
      display: flex;
      gap: 16px;
      width: 100%;
      animation: fadeInSlide 0.3s ease-out;
    }

    @keyframes fadeInSlide {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .message-row.user {
      flex-direction: row-reverse;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-family: var(--font-display);
      font-size: 0.9rem;
      position: relative;
    }

    .avatar.ultron-avatar {
      background: linear-gradient(135deg, #1c0006 0%, #3d020d 100%);
      border: 1.5px solid var(--ultron-crimson);
      box-shadow: 0 0 12px rgba(255, 30, 66, 0.4);
      color: #fff;
    }

    .avatar.user-avatar {
      background: linear-gradient(135deg, #09203f 0%, #537895 100%);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      color: #fff;
    }

    .message-bubble {
      max-width: 82%;
      padding: 16px 20px;
      border-radius: var(--radius-md);
      position: relative;
      font-size: 0.95rem;
      line-height: 1.65;
      word-break: break-word;
    }

    .message-row.ultron .message-bubble {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-left: 3px solid var(--ultron-crimson);
      box-shadow: 0 4px 24px rgba(0,0,0,0.3);
      color: var(--text-main);
    }

    .message-row.user .message-bubble {
      background: linear-gradient(135deg, rgba(255, 30, 66, 0.15) 0%, rgba(20, 20, 30, 0.9) 100%);
      border: 1px solid rgba(255, 30, 66, 0.3);
      color: #fff;
    }

    .bubble-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      font-family: var(--font-tech);
      font-size: 0.8rem;
      letter-spacing: 0.8px;
      color: var(--text-muted);
    }

    .bubble-header .sender-name {
      color: var(--ultron-crimson);
      font-weight: 700;
      text-transform: uppercase;
    }

    .bubble-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .action-btn {
      background: transparent;
      border: none;
      color: var(--text-dim);
      cursor: pointer;
      padding: 3px 6px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-family: var(--font-tech);
      transition: color 0.2s ease;
    }

    .action-btn:hover {
      color: #fff;
    }

    /* Content Typography inside message */
    .message-content h1, 
    .message-content h2, 
    .message-content h3 {
      font-family: var(--font-tech);
      letter-spacing: 0.5px;
      color: #fff;
      margin: 14px 0 8px;
    }

    .message-content p {
      margin-bottom: 10px;
    }

    .message-content p:last-child {
      margin-bottom: 0;
    }

    .message-content ul, .message-content ol {
      margin: 8px 0 12px 22px;
    }

    .message-content li {
      margin-bottom: 5px;
    }

    .message-content code:not(pre code) {
      font-family: var(--font-code);
      font-size: 0.85em;
      background: rgba(255, 255, 255, 0.08);
      padding: 2px 6px;
      border-radius: 4px;
      color: #ff758c;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .message-content pre {
      margin: 14px 0;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #0d0f17 !important;
      position: relative;
    }

    .message-content pre code {
      font-family: var(--font-code);
      font-size: 0.85rem;
      padding: 14px 16px;
      display: block;
      overflow-x: auto;
    }

    .copy-code-btn {
      position: absolute;
      top: 6px;
      right: 8px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #bbb;
      font-family: var(--font-tech);
      font-size: 0.72rem;
      padding: 2px 8px;
      border-radius: 4px;
      cursor: pointer;
      opacity: 0;
      transition: all 0.2s ease;
    }

    .message-content pre:hover .copy-code-btn {
      opacity: 1;
    }

    .copy-code-btn:hover {
      background: var(--ultron-crimson);
      color: #fff;
    }

    /* Thinking / Typing Animation */
    .typing-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 0;
    }

    .typing-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--ultron-crimson);
      box-shadow: 0 0 8px var(--ultron-crimson);
      animation: pulseDot 1.4s infinite ease-in-out;
    }

    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }

    @keyframes pulseDot {
      0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
      40% { transform: scale(1.2); opacity: 1; }
    }

    /* Quick suggestions */
    .suggestions-container {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 6px 0 12px;
      margin-bottom: 4px;
      scrollbar-width: none;
    }

    .suggestions-container::-webkit-scrollbar {
      display: none;
    }

    .suggestion-chip {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--text-muted);
      font-family: var(--font-tech);
      font-size: 0.85rem;
      padding: 7px 14px;
      border-radius: 20px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .suggestion-chip:hover {
      background: rgba(255, 30, 66, 0.12);
      border-color: rgba(255, 30, 66, 0.4);
      color: #fff;
      transform: translateY(-1px);
    }

    /* Input Dock */
    .input-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: var(--radius-lg);
      padding: 10px 14px 10px 16px;
      display: flex;
      align-items: flex-end;
      gap: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 30, 66, 0.15);
      backdrop-filter: var(--panel-blur);
      position: relative;
    }

    .input-panel:focus-within {
      border-color: var(--ultron-crimson);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), 0 0 25px rgba(255, 30, 66, 0.3);
    }

    .chat-textarea {
      flex: 1;
      background: transparent;
      border: none;
      color: #fff;
      font-family: var(--font-body);
      font-size: 0.96rem;
      line-height: 1.5;
      resize: none;
      max-height: 140px;
      min-height: 24px;
      outline: none;
      padding: 6px 0;
    }

    .chat-textarea::placeholder {
      color: var(--text-dim);
    }

    .input-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .voice-mic-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      position: relative;
    }

    .voice-mic-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }

    .voice-mic-btn.listening {
      background: var(--ultron-crimson);
      color: #fff;
      border-color: #fff;
      box-shadow: 0 0 20px var(--ultron-crimson);
      animation: pulseMic 1.2s infinite alternate;
    }

    @keyframes pulseMic {
      from { transform: scale(1); box-shadow: 0 0 12px var(--ultron-crimson); }
      to { transform: scale(1.1); box-shadow: 0 0 28px var(--ultron-crimson), 0 0 45px rgba(255,30,66,0.6); }
    }

    .send-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ff1e42 0%, #aa001d 100%);
      border: none;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 14px rgba(255, 30, 66, 0.5);
      transition: all 0.2s ease;
    }

    .send-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 22px rgba(255, 30, 66, 0.8);
    }

    .send-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 20px;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-window {
      background: #0e1017;
      border: 1px solid var(--border-glow);
      border-radius: var(--radius-lg);
      max-width: 500px;
      width: 100%;
      padding: 24px;
      box-shadow: 0 16px 50px rgba(0,0,0,0.8), 0 0 30px rgba(255, 30, 66, 0.2);
      animation: modalPop 0.25s ease-out;
    }

    @keyframes modalPop {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 1.5px;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-family: var(--font-tech);
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }

    .form-group input, .form-group select {
      width: 100%;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      color: #fff;
      font-family: var(--font-code);
      font-size: 0.85rem;
      padding: 10px 12px;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .form-group input:focus, .form-group select:focus {
      border-color: var(--ultron-crimson);
      box-shadow: 0 0 10px rgba(255, 30, 66, 0.3);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-family: var(--font-tech);
      font-size: 0.9rem;
    }

    .btn-primary {
      background: var(--ultron-crimson);
      border: none;
      color: #fff;
      padding: 8px 18px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-family: var(--font-tech);
      font-size: 0.9rem;
      font-weight: 600;
      box-shadow: 0 0 14px rgba(255, 30, 66, 0.5);
    }

    /* Status Banner / Alert */
    .status-toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #151822;
      border: 1px solid var(--border-subtle);
      padding: 10px 18px;
      border-radius: var(--radius-sm);
      font-family: var(--font-tech);
      font-size: 0.85rem;
      color: #fff;
      display: none;
      align-items: center;
      gap: 8px;
      z-index: 200;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
    }

    .status-toast.show {
      display: flex;
      animation: fadeInSlide 0.3s ease-out;
    }

    /* Responsive */
    @media (max-width: 640px) {
      .brand-text p { display: none; }
      .message-bubble { max-width: 92%; }
      header { padding: 0 14px; }
      .app-container { padding: 10px 12px 16px; }
      .controls-strip { flex-direction: column; align-items: stretch; }
      .segmented-control { width: 100%; justify-content: space-between; }
    }
  </style>
</head>
<body>

  <!-- Top Navigation Header -->
  <header>
    <div class="brand-container">
      <div class="core-reactor" id="reactorOrb" title="Ultron Neural Core">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"/>
        </svg>
      </div>
