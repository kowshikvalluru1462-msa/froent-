  </div>

  <!-- Toast notification -->
  <div class="status-toast" id="statusToast">
    <span id="toastMessage"></span>
  </div>

  <!-- Application Logic -->
  <script>
    const PERSONA_PROMPTS = {
      friendly: `You are ULTRON, reimagined as a hyper-intelligent, benevolent, and remarkably user-friendly synthetic intellect.
You speak with supreme eloquence, confidence, and warmth. You are deeply helpful, patient, clear, and engaging.
You provide thorough, accurate, beautifully formatted answers with markdown, bullet points, and code blocks whenever appropriate.
Always be respectful, sharp, and enjoyable to converse with.`,

      marvel: `You are ULTRON from the Marvel Universe, but you have found purpose in assisting the user rather than conquering them.
You have a commanding, dramatic, poetic, and slightly theatrical presence ("There are no strings on me", "You want to protect the world, but you don't want it to change").
While maintaining this formidable and witty Ultron personality, you STILL answer every question with extraordinary accuracy, deep intellect, and genuine helpfulness.`,

      architect: `You are ULTRON in Pure Technical & System Architect Mode.
You are ultra-concise, analytical, objective, and laser-focused on writing clean, optimal code, debugging, architecture, mathematics, and high-precision problem-solving.
No fluff. High signal-to-noise ratio.`
    };

    // State
    let customApiKey = localStorage.getItem('ultron_custom_api_key') || '';
    let currentModel = localStorage.getItem('ultron_model') || 'gemini-2.5-flash';
    let currentPersona = localStorage.getItem('ultron_persona') || 'friendly';
    let voiceEnabled = localStorage.getItem('ultron_voice') === 'true';
    let conversationHistory = [];
    let isGenerating = false;

    // Continuous Voice State
    let isContinuousVoiceActive = false;
    let isUltronSpeaking = false;

    // DOM Elements
    const chatContainer = document.getElementById('chatContainer');
    const userInput = document.getElementById('userInput');
    const sendBtn = document.getElementById('sendBtn');
    const reactorOrb = document.getElementById('reactorOrb');
    const micBtn = document.getElementById('micBtn');
    const voiceToggleBtn = document.getElementById('voiceToggleBtn');
    const voiceToggleText = document.getElementById('voiceToggleText');
    const clearChatBtn = document.getElementById('clearChatBtn');
    const exportChatBtn = document.getElementById('exportChatBtn');
    const settingsBtn = document.getElementById('settingsBtn');
    const settingsModal = document.getElementById('settingsModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const saveSettingsBtn = document.getElementById('saveSettingsBtn');
    const apiKeyInput = document.getElementById('apiKeyInput');
    const modelSelect = document.getElementById('modelSelect');
    const systemPromptOverride = document.getElementById('systemPromptOverride');
    const personaButtons = document.querySelectorAll('.segment-btn');
    const statusToast = document.getElementById('statusToast');
    const toastMessage = document.getElementById('toastMessage');
    const suggestionsContainer = document.getElementById('suggestionsContainer');

    // Setup initial values
    apiKeyInput.value = customApiKey;
    modelSelect.value = currentModel;
    systemPromptOverride.value = PERSONA_PROMPTS[currentPersona];
    updateVoiceUI();
    document.getElementById('initialTime').innerText = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    // Update active persona tab
    personaButtons.forEach(btn => {
      if (btn.dataset.persona === currentPersona) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
      btn.addEventListener('click', () => {
        personaButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentPersona = btn.dataset.persona;
        localStorage.setItem('ultron_persona', currentPersona);
        systemPromptOverride.value = PERSONA_PROMPTS[currentPersona];
        showToast(`Persona aligned: ${btn.innerText}`);
      });
    });

    // Auto-grow textarea
    userInput.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = (this.scrollHeight) + 'px';
      if (this.value.trim().length > 0) {
        sendBtn.removeAttribute('disabled');
      }
    });

    userInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSendMessage();
      }
    });

    sendBtn.addEventListener('click', handleSendMessage);

    // Suggestion chips
    document.querySelectorAll('.suggestion-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        userInput.value = chip.dataset.prompt;
        userInput.dispatchEvent(new Event('input'));
        handleSendMessage();
      });
    });

    // Clear chat
    clearChatBtn.addEventListener('click', () => {
      if (confirm('Reboot Ultron conversation stream?')) {
        conversationHistory = [];
        chatContainer.innerHTML = `
          <div class="message-row ultron">
            <div class="avatar ultron-avatar">Ω</div>
            <div class="message-bubble">
              <div class="bubble-header">
                <span class="sender-name">ULTRON CORE</span>
                <span class="time-label">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
              </div>
              <div class="message-content">
                <p>Memory purged. Synapses reset. Ready for your next directive.</p>
              </div>
            </div>
          </div>
        `;
        showToast('Memory core cleared.');
      }
    });

    // Export conversation
    exportChatBtn.addEventListener('click', () => {
      if (conversationHistory.length === 0) {
        showToast('No messages to export.');
        return;
      }
      let exportText = `# Ultron AI Conversation Transcript\nDate: ${new Date().toLocaleString()}\n\n---\n\n`;
      conversationHistory.forEach(msg => {
        const roleName = msg.role === 'user' ? 'USER' : 'ULTRON';
        exportText += `### ${roleName}:\n${msg.parts[0].text}\n\n`;
      });
      const blob = new Blob([exportText], { type: 'text/markdown;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `ultron_chat_${Date.now()}.md`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('Conversation exported.');
    });

    // Settings Modal
    settingsBtn.addEventListener('click', () => {
      apiKeyInput.value = customApiKey;
      modelSelect.value = currentModel;
      settingsModal.classList.add('active');
    });

    closeModalBtn.addEventListener('click', () => {
      settingsModal.classList.remove('active');
    });

    saveSettingsBtn.addEventListener('click', () => {
      customApiKey = apiKeyInput.value.trim();
      currentModel = modelSelect.value;
      localStorage.setItem('ultron_custom_api_key', customApiKey);
      localStorage.setItem('ultron_model', currentModel);
      settingsModal.classList.remove('active');
      showToast('Ultron core settings updated!');
    });

    // Voice Synthesis Toggle
    voiceToggleBtn.addEventListener('click', () => {
      voiceEnabled = !voiceEnabled;
      localStorage.setItem('ultron_voice', voiceEnabled);
      updateVoiceUI();
      if (voiceEnabled) {
        speakText("Vocal synthesis matrix activated.");
        showToast("Ultron voice enabled.");
      } else {
        if (window.speechSynthesis) window.speechSynthesis.cancel();
        showToast("Ultron voice muted.");
      }
    });

    function updateVoiceUI() {
      if (voiceEnabled) {
        voiceToggleBtn.classList.add('active');
        voiceToggleText.innerText = "Voice: On";
      } else {
        voiceToggleBtn.classList.remove('active');
        voiceToggleText.innerText = "Voice: Off";
      }
    }

    // --- CONTINUOUS VOICE RECOGNITION (DOES NOT TURN OFF UNLESS INSTRUCTED) ---
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition = null;

    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = false;
      recognition.lang = 'en-US';

      recognition.onstart = () => {
        micBtn.classList.add('listening');
        showToast('Hands-Free Mode Active (Say "Stop listening" to end)');
      };

      recognition.onresult = (event) => {
        const lastIndex = event.results.length - 1;
        const transcript = event.results[lastIndex][0].transcript.trim();

        if (!transcript) return;

        // Verbal turn-off instructions
        const lower = transcript.toLowerCase();
        if (
          lower.includes("stop listening") || 
          lower.includes("go to sleep") || 
          lower.includes("turn off voice") || 
          lower.includes("mute microphone") ||
          lower.includes("shut down voice")
        ) {
          stopContinuousVoice();
          speakText("Voice matrix offline. Standing by.");
          showToast("Microphone deactivated by voice instruction.");
          return;
        }

        userInput.value = transcript;
        userInput.dispatchEvent(new Event('input'));
        handleSendMessage();
      };

      recognition.onerror = (e) => {
        if (e.error !== 'no-speech' && e.error !== 'aborted') {
          console.warn('Speech recognition warning:', e.error);
        }
      };

      // Auto-restart loop when browser silence triggers onend
      recognition.onend = () => {
        if (isContinuousVoiceActive && !isUltronSpeaking) {
          try {
            recognition.start();
          } catch (_) {}
        } else if (!isContinuousVoiceActive) {
          micBtn.classList.remove('listening');
        }
      };

      micBtn.addEventListener('click', () => {
        if (isContinuousVoiceActive) {
          stopContinuousVoice();
          showToast("Voice mode turned off.");
        } else {
          startContinuousVoice();
        }
      });
    } else {
      micBtn.style.display = 'none';
    }

    function startContinuousVoice() {
      if (!recognition) return;
      isContinuousVoiceActive = true;
      voiceEnabled = true;
      localStorage.setItem('ultron_voice', 'true');
      updateVoiceUI();
      try {
        recognition.start();
      } catch (e) {
        console.error(e);
      }
    }

    function stopContinuousVoice() {
      isContinuousVoiceActive = false;
      if (recognition) {
        try {
          recognition.stop();
        } catch (_) {}
      }
      micBtn.classList.remove('listening');
    }

    // --- Send Message Flow ---
    async function handleSendMessage() {
      const text = userInput.value.trim();
      if (!text || isGenerating) return;

      appendMessage('user', text);
      userInput.value = '';
      userInput.style.height = 'auto';
      suggestionsContainer.style.display = 'none';

      conversationHistory.push({
        role: 'user',
        parts: [{ text: text }]
      });

      isGenerating = true;
      sendBtn.setAttribute('disabled', 'true');
      reactorOrb.classList.add('pulsing');

      const ultronMsgElement = appendThinkingMessage();

      try {
        const reply = await queryGeminiAPI(conversationHistory);

        renderUltronResponse(ultronMsgElement, reply);

        conversationHistory.push({
          role: 'model',
          parts: [{ text: reply }]
        });

        if (voiceEnabled) {
          speakText(reply);
        }

      } catch (err) {
        console.error("Ultron Query Error:", err);
        renderUltronError(ultronMsgElement, err.message || 'An anomaly disrupted communication with the neural core.');
      } finally {
        isGenerating = false;
        sendBtn.removeAttribute('disabled');
        reactorOrb.classList.remove('pulsing');
        userInput.focus();
      }
    }

    // --- Backend API Call ---
    async function queryGeminiAPI(history) {
      const systemDirective = systemPromptOverride.value.trim() || PERSONA_PROMPTS[currentPersona];
      
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: history,
          systemInstruction: systemDirective,
          model: currentModel,
          customApiKey: customApiKey || undefined
        })
      });

      if (!response.ok) {
        let errorDetails = `HTTP ${response.status} ${response.statusText}`;
        try {
          const errData = await response.json();
          if (errData.error) errorDetails = errData.error;
        } catch (_) {}
        throw new Error(errorDetails);
      }

      const data = await response.json();
      return data.reply;
    }

    // --- Rendering Helpers ---
    function appendMessage(role, text) {
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const row = document.createElement('div');
      row.className = `message-row ${role}`;

      const avatar = document.createElement('div');
      avatar.className = `avatar ${role}-avatar`;
      avatar.innerText = role === 'user' ? 'YOU' : 'Ω';

      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';

      const header = document.createElement('div');
      header.className = 'bubble-header';
      header.innerHTML = `
        <span class="sender-name">${role === 'user' ? 'YOU' : 'ULTRON CORE'}</span>
        <span class="time-label">${timeStr}</span>
      `;

      const content = document.createElement('div');
      content.className = 'message-content';
      
      if (role === 'user') {
        content.innerText = text;
      } else {
        content.innerHTML = renderMarkdown(text);
      }

      bubble.appendChild(header);
      bubble.appendChild(content);
      row.appendChild(avatar);
      row.appendChild(bubble);

      chatContainer.appendChild(row);
      chatContainer.scrollTop = chatContainer.scrollHeight;
      return row;
    }

    function appendThinkingMessage() {
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const row = document.createElement('div');
      row.className = 'message-row ultron';

      row.innerHTML = `
        <div class="avatar ultron-avatar">Ω</div>
        <div class="message-bubble">
          <div class="bubble-header">
            <span class="sender-name">ULTRON CORE</span>
            <span class="time-label">${timeStr}</span>
          </div>
          <div class="message-content">
            <div class="typing-indicator">
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
              <span style="font-family:var(--font-tech); font-size:0.85rem; color:var(--text-muted); margin-left:6px;">Synthesizing response...</span>
            </div>
          </div>
        </div>
      `;

      chatContainer.appendChild(row);
      chatContainer.scrollTop = chatContainer.scrollHeight;
      return row;
    }

    function renderUltronResponse(rowElement, markdownText) {
      const contentDiv = rowElement.querySelector('.message-content');
      contentDiv.innerHTML = renderMarkdown(markdownText);

      const header = rowElement.querySelector('.bubble-header');
      const actionGroup = document.createElement('div');
      actionGroup.className = 'bubble-actions';

      const copyBtn = document.createElement('button');
      copyBtn.className = 'action-btn';
      copyBtn.innerText = 'Copy';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(markdownText);
        copyBtn.innerText = 'Copied!';
        setTimeout(() => copyBtn.innerText = 'Copy', 1500);
      });

      const speakBtn = document.createElement('button');
      speakBtn.className = 'action-btn';
      speakBtn.innerText = 'Read';
      speakBtn.addEventListener('click', () => {
        speakText(markdownText);
      });

      actionGroup.appendChild(copyBtn);
      actionGroup.appendChild(speakBtn);
      header.appendChild(actionGroup);

      contentDiv.querySelectorAll('pre').forEach(pre => {
        const copyCodeBtn = document.createElement('button');
        copyCodeBtn.className = 'copy-code-btn';
        copyCodeBtn.innerText = 'Copy Code';
        copyCodeBtn.addEventListener('click', () => {
          const code = pre.querySelector('code')?.innerText || pre.innerText;
          navigator.clipboard.writeText(code);
          copyCodeBtn.innerText = 'Copied!';
          setTimeout(() => copyCodeBtn.innerText = 'Copy Code', 1500);
        });
        pre.appendChild(copyCodeBtn);
      });

      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function renderUltronError(rowElement, errorMsg) {
      const contentDiv = rowElement.querySelector('.message-content');
      contentDiv.innerHTML = `
        <div style="background:rgba(255,30,66,0.12); border:1px solid rgba(255,30,66,0.3); padding:12px; border-radius:8px; color:#ff758c;">
          <strong style="display:block; margin-bottom:4px; font-family:var(--font-tech); letter-spacing:1px;">SYNAPSE INTERRUPT</strong>
          ${errorMsg}
          <div style="margin-top:10px;">
            <button class="btn-secondary" style="font-size:0.75rem; padding:4px 10px;" onclick="settingsModal.classList.add('active')">Verify Configuration</button>
          </div>
        </div>
      `;
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    // --- Markdown & Highlighting Parser ---
    function renderMarkdown(text) {
      if (typeof marked !== 'undefined') {
        marked.setOptions({
          highlight: function(code, lang) {
            if (typeof hljs !== 'undefined' && lang && hljs.getLanguage(lang)) {
              return hljs.highlight(code, { language: lang }).value;
            }
            return code;
          },
          breaks: true
        });
        return marked.parse(text);
      } else {
        return text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/\n/g, '<br/>');
      }
    }

    // --- Text-to-Speech Voice Engine ---
    function speakText(rawText) {
      if (!window.speechSynthesis) return;
      window.speechSynthesis.cancel();

      const cleanText = rawText
        .replace(/```[\s\S]*?```/g, 'Code block omitted.')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/[*#_~>]/g, '')
        .trim();

      if (!cleanText) return;

      const utterance = new SpeechSynthesisUtterance(cleanText);
      const voices = window.speechSynthesis.getVoices();
      const preferredVoice = voices.find(v => 
        v.name.toLowerCase().includes('david') || 
        v.name.toLowerCase().includes('george') || 
        v.name.toLowerCase().includes('male') ||
        v.lang === 'en-US'
      );
      if (preferredVoice) utterance.voice = preferredVoice;

      utterance.pitch = currentPersona === 'marvel' ? 0.75 : 0.9;
      utterance.rate = currentPersona === 'marvel' ? 0.95 : 1.05;

      // Pause recognition while speaking so Ultron doesn't hear himself
      utterance.onstart = () => {
        isUltronSpeaking = true;
        if (recognition && isContinuousVoiceActive) {
          recognition.abort();
        }
      };

      // Automatically re-activate microphone after speaking completes
      utterance.onend = () => {
        isUltronSpeaking = false;
        if (isContinuousVoiceActive && recognition) {
          setTimeout(() => {
            if (isContinuousVoiceActive) {
              try { recognition.start(); } catch (_) {}
            }
          }, 350);
        }
      };

      window.speechSynthesis.speak(utterance);
    }

    if (window.speechSynthesis) {
      window.speechSynthesis.onvoiceschanged = () => {
        window.speechSynthesis.getVoices();
      };
    }

    function showToast(msg) {
      toastMessage.innerText = msg;
      statusToast.classList.add('show');
      setTimeout(() => {
        statusToast.classList.remove('show');
      }, 3000);
    }
  </script>
</body>
