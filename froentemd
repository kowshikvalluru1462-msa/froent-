  <!-- Configuration Modal -->
  <div class="modal-overlay" id="settingsModal">
    <div class="modal-window">
      <div class="modal-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ultron-crimson)" stroke-width="2">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        <span>Ultron Core Configuration</span>
      </div>

      <div class="form-group">
        <label for="apiKeyInput">Custom Gemini API Key (Optional Override):</label>
        <input type="password" id="apiKeyInput" placeholder="Leave empty to use server .env key" />
      </div>

      <div class="form-group">
        <label for="modelSelect">Gemini Model Architecture:</label>
        <select id="modelSelect">
          <option value="gemini-2.5-flash" selected>gemini-2.5-flash (Fast & Responsive)</option>
          <option value="gemini-2.0-flash">gemini-2.0-flash (High Throughput)</option>
          <option value="gemini-1.5-flash">gemini-1.5-flash (Standard)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="systemPromptOverride">Custom Directive (Ultron Soul):</label>
        <textarea id="systemPromptOverride" rows="3" style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#fff; border-radius:8px; padding:8px; font-family:var(--font-body); font-size:0.85rem; outline:none; resize:vertical;"></textarea>
