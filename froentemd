      <div class="input-actions">
        <button id="micBtn" class="voice-mic-btn" title="Continuous Voice Mode (Stays on until instructed)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
